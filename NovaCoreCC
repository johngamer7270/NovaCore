local repo = "https://raw.githubusercontent.com/violin-suzutsuki/LinoriaLib/main/"

local Library = loadstring(game:HttpGet(repo .. "Library.lua"))()
local ThemeManager = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))()
local SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()

-- Create Window Container
local Window = Library:CreateWindow({
    Title = 'NovaCoreCC',
    Center = true,
    AutoShow = true,
    TabPadding = 8,
    MenuFadeTime = 0.2
})

-- Declare Navigation Tabs
local Tabs = {
    Main = Window:AddTab('Main'),
    ['UI Settings'] = Window:AddTab('UI Settings'),
}

-- Create Functional Groupboxes
local MainGroup = Tabs.Main:AddLeftGroupbox('Auto')
local MenuGroup = Tabs['UI Settings']:AddLeftGroupbox('Menu')

-- ==========================================
--  2. DEFINE GAME OBJECTS & DEPENDENCIES
-- ==========================================
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Search for active Tycoon instances safely
local userTycoon = (function()
    for _, v in pairs(workspace:GetChildren()) do
        if v:IsA("Folder") and v.Name:match("Tycoon%d") then
            if v:FindFirstChild("Owner") and v.Owner.Value == LocalPlayer then
                return v
            end
        end
    end
end)()

-- Notify and cancel operations safely if configuration folder is missing
if not userTycoon then
    Library:Notify("Error: Your Tycoon folder could not be found!", 5)
    return
end

-- State Execution Trackers
local Buying = false
local Buttons = {} 
local Trees = {}

-- ==========================================
--  3. LINORIALIB UI ELEMENT DECLARATIONS
-- ==========================================

-- Populate Automation Switches (Uses strict Linoria Indexes)
MainGroup:AddToggle('AutoBuyToggle', { Text = 'Auto Buy', Default = false })
MainGroup:AddToggle('AutoUpgradeToggle', { Text = 'Auto Upgrade', Default = false })
MainGroup:AddToggle('AutoFruitToggle', { Text = 'Auto Fruit', Default = false })

-- Populate Interface Settings Actions
